{
  "name": "comment-core-library",
  "title": "CommentCoreLibrary",
  "description": "Javascript library for organizing and displaying danmaku comments",
  "bugs": {
    "url": "https://github.com/jabbany/CommentCoreLibrary/issues",
    "email": "knh.jabbany@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jabbany/CommentCoreLibrary.git"
  },
  "homepage": "https://github.com/jabbany/CommentCoreLibrary#readme",
  "author": "Jim Chen <knh.jabbany@gmail.com>",
  "license": "MIT",
  "keywords": [
    "danmaku",
    "video",
    "comments",
    "caption",
    "browser",
    "danmu"
  ],
  "version": "0.11.1",
  "main": "dist/CommentCoreLibrary.js",
  "module": "dist/CommentCoreLibrary.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/CommentCoreLibrary.mjs",
      "default": "./dist/CommentCoreLibrary.js"
    },
    "./css/*": "./dist/css/*",
    "./scripting/*": "./dist/scripting/*",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/helpers": "^0.5.23",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "acorn": "^8.19.0",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "rollup": "^4.64.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "clean": "node build/clean.mjs",
    "build": "pnpm clean && rollup -c && pnpm build:types",
    "build:core": "rollup -c --configTarget core && pnpm build:types",
    "build:scripting": "rollup -c --configTarget scripting",
    "build:types": "tsc -p tsconfig.types.json",
    "watch": "rollup -c -w",
    "start": "rollup -c -w",
    "typecheck": "tsc -p tsconfig.json && tsc -p spec/tsconfig.json",
    "check:ascii": "node build/check-ascii.mjs",
    "check:es5": "node build/check-es5.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.mts",
    "verify": "pnpm typecheck && pnpm check:ascii && pnpm build && pnpm check:es5 && pnpm test && pnpm test:dist"
  }
}
